    <string name="record_auto_recording">Auto recording</string>
    <string name="record_waiting_for_fix">Finding your position…</string>
    <string name="record_current_track">Current trip · %1$s</string>
    <!-- Fills the activity slot above while nothing has been detected yet. -->
    <string name="record_activity_idle">Idle</string>
    <string name="record_stat_speed">Speed</string>
    <string name="record_stat_elevation">Elevation</string>
    <string name="record_keep_screen_on">Keep screen on</string>
    <string name="record_keep_screen_on_charging">While charging, with the app open.</string>
    <string name="record_keep_screen_on_idle">Available while charging.</string>

