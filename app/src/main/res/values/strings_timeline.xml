<?xml version="1.0" encoding="utf-8"?>
<!-- TimelineTab: the Timeline tab's day headings and rows. -->
<resources>
    <!-- Empty state, backup restore and Google Timeline import -->
    <string name="timeline_empty">No trips yet. They appear here once recording captures some movement.</string>
    <string name="timeline_restoring">Restoring your backup — the timeline will appear when it finishes</string>
    <plurals name="timeline_restoring_count">
        <item quantity="one">Restoring… %1$d trip</item>
        <item quantity="other">Restoring… %1$d trips</item>
    </plurals>
    <plurals name="timeline_restoring_count_of">
        <item quantity="one">Restoring… %1$d of %2$d trip</item>
        <item quantity="other">Restoring… %1$d of %2$d trips</item>
    </plurals>
    <string name="timeline_google_importing">Importing your Google Timeline — the trips will appear when it finishes</string>
    <plurals name="timeline_google_importing_count_of">
        <item quantity="one">Importing… %1$d of %2$d trip</item>
        <item quantity="other">Importing… %1$d of %2$d trips</item>
    </plurals>

    <!--
      Both re-derivation sweeps share this one line: which rule is being re-walked is nothing a
      reader can act on, and naming it puts a mechanism on screen the app names nowhere else.
      "Reprocessing", not "Trimming" or "Correcting": a sweep re-derives, and hands back as
      readily as it takes.
    -->
    <string name="timeline_sweep">Reprocessing trips</string>

    <!-- What heads an Insights journey row the naming pass found no place for — the bare fact of
         having been away. -->
    <plurals name="timeline_nights_away">
        <item quantity="one">%d night away</item>
        <item quantity="other">%d nights away</item>
    </plurals>
    <!-- Leads the timeline's journey band, ahead of the destination names: which day of how many. -->
    <string name="timeline_away_day_of">Day %1$d of %2$d</string>

    <!-- The tab row over the timeline's two views: the day-by-day list, and one day on a map. -->
    <string name="timeline_view_list">List</string>
    <string name="timeline_view_map">Map</string>

    <!-- The map page's day selector and its one empty state. -->
    <string name="timeline_map_prev_day">Previous day</string>
    <string name="timeline_map_next_day">Next day</string>
    <string name="timeline_map_empty_day">Nothing recorded on this day</string>

    <!-- Row actions, read aloud -->
    <string name="timeline_share_day">Share %1$s tracks</string>
    <string name="timeline_scroll_to_day">Scroll to a day</string>
    <string name="timeline_merge">Merge trips</string>
    <string name="timeline_undo_merged">Trips merged</string>
    <string name="timeline_undo_deleted">Trip deleted</string>
    <string name="timeline_hide_stay">Hide stay</string>
    <string name="timeline_undo_hidden">Stay hidden</string>
    <string name="timeline_show_hidden_stay">Show hidden stay</string>
    <string name="timeline_undo_shown">Stay shown</string>

    <!--
      Stay rows. The clock time is drawn rather than interpolated — it carries its own colour marks
      for a zone shift — and reaches its slot through `annotatedStringResource`, so each of these is
      a whole sentence and free to put the time wherever this language wants it.
    -->
    <string name="timeline_all_day">All day</string>
    <string name="timeline_stay_since">%1$s – now</string>
    <string name="timeline_stay_until">Until %1$s</string>
    <string name="timeline_stay_from">From %1$s</string>
    <string name="timeline_stay_between">%1$s – %2$s</string>
    <string name="timeline_short_stop">Short stop</string>
    <string name="timeline_short_stop_mergeable">Short stop, can be merged away</string>
    <string name="timeline_stayed">Stayed</string>
    <!-- A half of a gap cut at midnight: the absence runs on from, or until, this time. -->
    <string name="timeline_gap_from">from %1$s</string>
    <string name="timeline_gap_until">until %1$s</string>
    <string name="timeline_unnamed_place">unnamed place</string>

    <!-- A stay row's visit count. Worded here rather than shared with the Places tab's own count:
         the prefixes are what keep each screen's wording its own, and a language may count a place
         row's visits with a different word (Russian says "раз" there). -->
    <plurals name="timeline_visits">
        <item quantity="one">%d visit</item>
        <item quantity="other">%d visits</item>
    </plurals>

    <string name="timeline_show_parts">Show parts</string>
    <string name="timeline_hide_parts">Hide parts</string>
</resources>
