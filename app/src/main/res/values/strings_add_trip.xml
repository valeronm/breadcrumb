<?xml version="1.0" encoding="utf-8"?>
<!-- AddTripScreen: entering a trip nothing recorded, as two pins and two times. -->
<resources>
    <string name="addtrip_title_add">Add missing trip</string>
    <string name="addtrip_title_edit">Edit trip</string>

    <!-- Why the form will not commit -->
    <string name="addtrip_error_order">Arrival must be after departure</string>
    <string name="addtrip_error_future">Departure is in the future</string>
    <string name="addtrip_overlaps">Overlaps an existing trip</string>
    <string name="addtrip_gone">This trip is no longer there</string>

    <!-- Picking a place -->
    <string name="addtrip_search_placeholder">Search cities and places</string>
    <!-- One whole sentence per end rather than a stem plus a noun: only English composes that way. -->
    <string name="addtrip_tap_origin">Tap a place or long-press to set the origin</string>
    <string name="addtrip_tap_destination">Tap a place or long-press to set the destination</string>
    <!-- ODbL's credit, at the results it applies to. -->
    <string name="addtrip_no_matches">No matches</string>

    <!-- Asking the online router for the trip's path: the chip's offer, the chip once it has one
         (the length, then the time it takes), and the one message a failure gets. -->
    <string name="addtrip_follow_roads">Follow roads</string>
    <string name="addtrip_along_roads">Along roads · %1$s · %2$s</string>
    <string name="addtrip_no_roads">No road path found between these points</string>

    <string name="addtrip_origin">Origin</string>
    <string name="addtrip_destination">Destination</string>
    <!-- Each end's label above its date and time, which stand alone rather than in a sentence. -->
    <string name="addtrip_departure">Departure</string>
    <string name="addtrip_arrival">Arrival</string>
    <string name="addtrip_departure_stayed">Departure · stayed %1$s</string>
    <string name="addtrip_arrival_stayed">Arrival · stayed %1$s</string>
    <string name="addtrip_pick_date">Date</string>
    <string name="addtrip_pick_time">Time</string>
    <string name="addtrip_change_place">Change place</string>
    <string name="addtrip_change_type">Change trip type</string>
    <string name="addtrip_estimated">Estimated along roads</string>
    <string name="addtrip_estimated_was">Estimated along roads · was %s</string>
    <string name="addtrip_restore_time">Restore</string>
    <string name="addtrip_estimate">Estimate</string>
    <string name="addtrip_no_type">No trip type yet</string>
    <string name="addtrip_departure_time_title">Departure time</string>
    <string name="addtrip_arrival_time_title">Arrival time</string>
    <!-- The offset is rendered as "+2h" style text, the way the timeline says it. -->
    <string name="addtrip_local_clock_note">On the local clock, %1$s from yours</string>

    <!--
      What a trip end is called before anything can name it. A *point*, not a pin: these two become
      the manual trip's two stored points, and a pin is a place's — see `docs/glossary/`.
    -->
    <string name="addtrip_pin_placed">Point placed</string>
    <string name="addtrip_no_pin">No point yet</string>
</resources>
