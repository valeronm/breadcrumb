<!--
  Privacy: the app-lock screen and the system biometric prompt it raises. The prompt covers the
  screen entirely, so the two must not say the same thing, and neither says the app is locked —
  `docs/glossary/en.md` has the rule.
-->
<resources>
    <string name="lock_screen_title">Your history is private</string>
    <string name="lock_screen_unlock">Unlock</string>
    <string name="lock_prompt_title">Unlock Breadcrumb</string>
    <string name="lock_prompt_subtitle">Only you can open it</string>
    <plurals name="lock_pending_imports">
        <item quantity="one">A track file is waiting to be imported.</item>
        <item quantity="other">%d track files are waiting to be imported.</item>
    </plurals>
</resources>
