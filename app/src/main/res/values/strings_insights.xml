<?xml version="1.0" encoding="utf-8"?>
<!-- InsightsScreens: the Insights tab. -->
<resources>
    <string name="insights_empty">No journeys yet. They appear here once you tag a place as Home in Places — any run of nights spent elsewhere is a journey.</string>
    <!-- Read aloud for a journey row's icon. -->
    <string name="insights_journey">Journey</string>

    <!--
      A year's totals. Plurals rather than an "n one/many" helper: two forms is an English fact,
      not a universal one, and several languages the app may take need three or more.
    -->
    <plurals name="insights_journeys">
        <item quantity="one">%d journey</item>
        <item quantity="other">%d journeys</item>
    </plurals>
    <plurals name="insights_nights">
        <item quantity="one">%d night</item>
        <item quantity="other">%d nights</item>
    </plurals>
    <plurals name="insights_cities">
        <item quantity="one">%d city</item>
        <item quantity="other">%d cities</item>
    </plurals>
    <plurals name="insights_countries">
        <item quantity="one">%d country</item>
        <item quantity="other">%d countries</item>
    </plurals>
</resources>
