<?xml version="1.0" encoding="utf-8"?>
<!-- InsightsTab: the Insights tab. -->
<resources>
    <string name="insights_empty">No journeys yet. They appear here once you tag a place as Home in Places — any run of nights spent elsewhere is a journey.</string>
    <!-- Read aloud for a journey row's icon. -->
    <string name="insights_journey">Journey</string>
    <!-- The scrubber handle, read aloud. Named for what dragging travels through. -->
    <string name="insights_scroll_to_year">Scroll to a year</string>

    <!--
      A year's totals. Plurals rather than an "n one/many" helper: two forms is an English fact,
      not a universal one, and several languages the app may take need three or more.
    -->
    <plurals name="insights_journeys">
        <item quantity="one">%d journey</item>
        <item quantity="other">%d journeys</item>
    </plurals>
    <plurals name="insights_nights">
        <item quantity="one">%d night</item>
        <item quantity="other">%d nights</item>
    </plurals>
    <plurals name="insights_cities">
        <item quantity="one">%d city</item>
        <item quantity="other">%d cities</item>
    </plurals>
    <plurals name="insights_countries">
        <item quantity="one">%d country</item>
        <item quantity="other">%d countries</item>
    </plurals>

    <!-- The tab's two pages: the journeys above, a month against the year behind it below. -->
    <string name="insights_tab_journeys">Journeys</string>
    <string name="insights_tab_statistics">Statistics</string>

    <string name="insights_stats_empty">No figures yet. They appear here once your history holds a trip, or a stay at a place you have given a category in Places.</string>
    <!--
      The months on screen hold nothing, though the history elsewhere does — so this says what to do
      about it rather than what is missing. Deliberately not "nothing recorded": an imported trip and
      a hand-entered one never went near the recorder, and *recording* names only one of the ways a
      trip arrives.
    -->
    <string name="insights_stats_window_empty">These months are empty. Step back to reach the rest of your history.</string>

    <!--
      The two sections, named for what their rows *are* rather than for a measure: each row states
      two figures (a distance and the time it took, hours and the visits they were spread over), so a
      heading naming one of them contradicts half of what is under it.
    -->
    <string name="insights_stats_movement">Movement</string>
    <string name="insights_stats_places">Places</string>

    <!--
      How many separate visits the month's hours at one kind of place were spread over — a count of
      occasions, which is why Russian words it as `place_row_visits` does rather than as
      `place_visits`. Authored here rather than shared with the Places tab's own count: the prefixes
      are what keep each screen's wording its own, so a rewording there cannot silently reword this.
    -->
    <plurals name="insights_stats_visits">
        <item quantity="one">%d visit</item>
        <item quantity="other">%d visits</item>
    </plurals>

    <!-- Read aloud for the arrows that step the shown month. -->
    <string name="insights_stats_previous_month">Previous month</string>
    <string name="insights_stats_next_month">Next month</string>
</resources>
