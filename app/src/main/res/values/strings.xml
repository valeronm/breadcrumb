<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's own name, and the wording shared by more than one screen. Everything else lives in a
  strings_<screen>.xml beside this one, mirroring the one-file-per-screen split of `ui/`. The files
  are a filing system only: Android merges every values/*.xml into one table, so a name has to be
  unique across all of them and the prefixes are what keep them apart.
-->
<resources>
    <!-- A product name, not wording. Overridden per build variant to tell the launcher icons apart. -->
    <string name="app_name" translatable="false">Breadcrumb</string>
    <!--
      Deliberately not app_name: that one is overridden per build variant to tell the *launcher*
      icons apart ("Breadcrumb (debug)"), and a screen naming the product wants the name alone —
      the badge or the version line beside it already says which build this is.
    -->
    <string name="app_brand" translatable="false">Breadcrumb</string>

    <string name="common_back">Back</string>
    <string name="common_cancel">Cancel</string>
    <string name="common_restore_or_import">Restore or import</string>
    <string name="common_ok">OK</string>
    <string name="common_undo">Undo</string>
    <!-- A city whose name another city in its country shares, with the region that tells them apart. -->
    <string name="common_city_in_region">%1$s, %2$s</string>
    <string name="common_off">Off</string>
    <string name="common_stop">Stop</string>
    <!-- The swipe-to-delete action, read aloud on a place row and on a track row alike. -->
    <string name="common_delete">Delete</string>
    <!-- Commits an editor: the trip form and the place editor both hold everything until it is
         pressed, so the word says a row is written rather than that the reader has finished. -->
    <string name="common_save">Save</string>
    <!-- A change that failed with nothing more specific to say about it. -->
    <string name="common_failed">Something went wrong</string>
    <!-- Stat-cell labels, on the Record card and on a track's detail. -->
    <string name="common_stat_distance">Distance</string>
    <string name="common_stat_duration">Duration</string>
    <!-- Stands in for a figure the recorder has no reading for yet. Punctuation, not wording. -->
    <string name="common_no_value" translatable="false">—</string>

    <!--
      Relative days. Lowercase on purpose: these read inside a phrase ("First visit today"), and the
      one place that heads a row with them capitalizes on render.
    -->
    <string name="relative_today">today</string>
    <string name="relative_yesterday">yesterday</string>
    <plurals name="relative_days_ago">
        <item quantity="one">%d day ago</item>
        <item quantity="other">%d days ago</item>
    </plurals>

    <!-- Handing a coordinate to the maps app, or a link to the browser, when the device has none. -->
    <string name="maps_no_app">No maps app to open this in</string>
    <string name="browser_no_app">No browser to open this in</string>

    <!-- Share sheet titles, raised from the trip page and the day header. What leaves the app is a
         track; the format is not named here — see `docs/glossary/en.md`. -->
    <string name="share_gpx_track">Share track</string>
    <string name="share_gpx_tracks">Share tracks</string>

    <!-- GPX import result, joined with " · ". Shown from Settings and from an "open with". -->
    <plurals name="gpx_imported">
        <item quantity="one">Imported %d track</item>
        <item quantity="other">Imported %d tracks</item>
    </plurals>
    <plurals name="gpx_duplicates">
        <item quantity="one">%d duplicate skipped</item>
        <item quantity="other">%d duplicates skipped</item>
    </plurals>
    <plurals name="gpx_overlapping">
        <item quantity="one">%d overlapping skipped</item>
        <item quantity="other">%d overlapping skipped</item>
    </plurals>
    <plurals name="gpx_failed">
        <item quantity="one">%d failed</item>
        <item quantity="other">%d failed</item>
    </plurals>
    <string name="common_osm_credit">Online results © OpenStreetMap</string>
    <!-- Each placeholder is a link: the basemap's maker, then the data credit FOSSGIS's terms ask
         for — the project, the licence and the report-an-error page. -->
    <string name="common_map_credit">© %1$s · %4$s\nData © %2$s contributors (%3$s)</string>
    <string name="common_map_reset_view">Reset view</string>
    <string name="common_osm_report_error">Report a map error</string>
    <!-- Where a trip or a place came from; one recorded or made in the app carries none. -->
    <string name="common_origin_gpx" translatable="false">GPX</string>
    <string name="common_origin_google_timeline">Google Timeline</string>
    <string name="common_origin_entered_by_hand">Entered by hand</string>
</resources>
