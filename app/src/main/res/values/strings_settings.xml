    <!--
      Import / export say *track* where the rest of the app says *trip*, and name GPX where nothing
      else does: both follow from these rows being about the file, not the journey — the reader has
      to recognise one by its extension. A backup is the history itself, so it says trip.
      `docs/glossary/en.md` has both rules.
    -->
    <string name="data_import_tracks">Import tracks</string>
