    <!-- Point quality -->
    <string name="quality_description">Which recorded points count as good.</string>
    <string name="quality_require_fix">Require satellite fix</string>
    <string name="quality_require_fix_sub">Drops guessed positions, like in a tunnel.</string>
    <string name="quality_accuracy_description">Points less accurate than this are marked noisy and excluded.</string>
    <string name="quality_max_accuracy">Max accuracy radius</string>

    <!-- Auto-pause -->
    <string name="pause_description">A stop shorter than this keeps the track open — moving again continues the same track. When set to Off, every stop ends the track.</string>
    <string name="pause_resume_window">Resume window</string>
    <string name="pause_keep_recording">Keep recording while moving</string>
    <string name="pause_keep_recording_sub">Ignores \"stopped\" while your position keeps changing — for ferries, trains and buses, where you sit still but the journey doesn\'t. Uses more battery.</string>

    <!-- GPS search -->
    <string name="gps_description">If no good position arrives for this long, GPS pauses and retries when you move or another app gets a location. When set to Off, GPS never stops searching.</string>
    <string name="gps_give_up_after">Give up after</string>

    <!-- Track filtering -->
    <string name="filter_description">Tracks under these limits are moved to Recently deleted when they finish.</string>
    <string name="filter_min_duration">Min duration</string>
    <string name="filter_min_length">Min length</string>
    <string name="filter_extent_description">How far the track spread from where it started — filters out standing-still noise.</string>
    <string name="filter_min_extent">Min extent</string>

    <!-- Privacy and app lock -->
    <string name="privacy_description">Recording is never locked — tracks keep being recorded whether or not the app is.</string>
    <string name="privacy_block_screenshots">Block screenshots</string>
    <string name="privacy_block_screenshots_sub">Also hides the app\'s preview in the recent-apps switcher, which otherwise shows a map of where you were.</string>
    <string name="privacy_online_search">Online place search</string>
    <string name="privacy_online_search_sub">Lets the add-trip form find hotels and addresses by name. Typed searches are sent to photon.komoot.io (OpenStreetMap); off keeps search fully on this device.</string>
    <string name="lock_require_unlock">Require unlock</string>
    <string name="lock_require_unlock_sub">Opening the app asks for your fingerprint or device PIN.</string>
    <string name="lock_no_screen_lock">Set a screen lock on this device first.</string>
    <string name="lock_trust_keyguard">Trust the phone\'s unlock</string>
    <string name="lock_trust_keyguard_sub">Skip the app\'s prompt when the phone itself has been unlocked since you last left the app — no second unlock right after the first. Off, the app is locked even to someone who can open the phone.</string>
    <string name="lock_again">Lock again</string>
    <string name="lock_again_sub">Leaving the app briefly — to pick a file or grant a permission — shouldn\'t ask again.</string>
    <string name="lock_immediately">Immediately</string>
    <!-- Wraps a duration from the ladder, which is still English until the ICU pass. -->
    <string name="lock_after">After %1$s</string>

