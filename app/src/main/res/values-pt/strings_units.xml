<?xml version="1.0" encoding="utf-8"?>
<!--
  The measure symbols are the same in Portuguese as in English — km, m, km/h are international.
  They are repeated here rather than left to fall back so that a translator has one obvious place
  to change them, and so Lint's MissingTranslation stays meaningful for this file.
-->
<resources>
    <string name="unit_kilometers">km</string>
    <string name="unit_miles">mi</string>
    <string name="unit_meters">m</string>
    <string name="unit_feet">ft</string>
    <string name="unit_kmh">km/h</string>
    <string name="unit_mph">mph</string>
    <!-- "sat" abbreviates satélites as readily as satellites; dB is the SI symbol either way. -->
    <string name="unit_satellites">sat</string>
    <string name="unit_decibels">dB</string>

    <!-- The ladder's letters follow the Portuguese words: ano, mês, dia, hora, minuto, segundo. -->
    <string name="duration_year">a</string>
    <string name="duration_month">m</string>
    <string name="duration_day">d</string>
    <string name="duration_hour">h</string>
    <string name="duration_minute">min</string>
    <string name="duration_second">s</string>
    <string name="duration_recording">a gravar</string>

    <string name="duration_seconds_step">%1$d s</string>
    <string name="duration_minutes_step">%1$d min</string>
    <string name="duration_minutes_seconds_step">%1$dmin %2$ds</string>
</resources>
