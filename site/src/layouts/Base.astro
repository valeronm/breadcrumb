---
import "@fontsource-variable/bricolage-grotesque/opsz.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/global.css";
import { Image, getImage } from "astro:assets";
import icon from "../../../docs/store-listing/play-icon.png";
import featureGraphic from "../../../docs/store-listing/feature-graphic.png";
import GitHubMark from "../assets/github-mark.svg";

interface Props {
  title: string;
  description: string;
  // An app page fills the viewport under the header, outside the page container and with no footer.
  app?: boolean;
}

const { title, description, app = false } = Astro.props;
const favicon = await getImage({ src: icon, width: 64, format: "png", layout: "none" });
const shareImage = await getImage({ src: featureGraphic, format: "jpeg", quality: 80, layout: "none" });
const pageTitle = Astro.url.pathname === "/" ? title : `${title} – Breadcrumb`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const current = (href: string) => (Astro.url.pathname === href ? "page" : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={favicon.src} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(shareImage.src, Astro.site)} />
    <meta property="og:image:width" content={shareImage.attributes.width} />
    <meta property="og:image:height" content={shareImage.attributes.height} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body class:list={{ app }}>
    <header class="top">
      <div class="top-inner">
        <a class="brand" href="/"><Image src={icon} width={28} densities={[1, 2]} loading="eager" alt="" /> Breadcrumb</a>
        <nav>
          <a href="/viewer/" aria-current={current("/viewer/")}>Viewer</a>
          <a href="/privacy/" aria-current={current("/privacy/")}>Privacy</a>
          <a href="/#install">Install</a>
          <a class="github" href="https://github.com/valeronm/breadcrumb" aria-label="Source on GitHub" title="Source on GitHub">
            <GitHubMark width="20" height="20" aria-hidden="true" />
          </a>
        </nav>
      </div>
    </header>

    <main class:list={{ page: !app }}>
      <slot />
    </main>

    {
      !app && (
        <footer>
          <p>
            Map data © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>,
            served by <a href="https://protomaps.com/">Protomaps</a>
          </p>
          <p>City names from <a href="https://www.geonames.org/">GeoNames</a>, CC BY 4.0</p>
        </footer>
      )
    }
  </body>
</html>
